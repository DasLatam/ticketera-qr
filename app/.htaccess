# Todo lo que no es un archivo real va a index.php. Funciona tanto si la app
# es la raíz del dominio como si REQUEST_URI conserva la ruta original.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Opcional: forzar https y un solo dominio. Descomentá y cambiá example.com.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^example\.com$ [NC]
  # RewriteRule ^(.*)$ https://example.com/$1 [R=301,L,NE]

  RewriteRule ^(nucleo|vistas)(/|$) - [F,L]
  RewriteRule ^\.(git|env) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Aplicación instalable: el manifiesto con su tipo. El service worker
# (/sw.js) lo sirve index.php sin caché y con la versión publicada adentro.
AddType application/manifest+json .webmanifest
